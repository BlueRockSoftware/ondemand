K8S_USERNAME_PREFIX=""
NAMESPACE_PREFIX=""
NETWORK_POLICY_ALLOW_CIDR="127.0.0.1/32"
# Node subnet allowed into session pods (the portal proxies via NodePort, whose
# local-delivery traffic is seen with the node IP source). Optional: the hook
# defaults it to NETWORK_POLICY_ALLOW_CIDR when unset.
NETWORK_POLICY_ALLOW_NODE_CIDR="127.0.0.1/32"
NFS_SERVER="172.20.26.45"
EGRESS_PROXY_NAMESPACE="ood"
# Namespace of the OOD portal (PUN) pods. Required: k8s-bootstrap-ondemand.sh
# hard-fails if unset (spec 043) because network-policy.yaml scopes session
# ingress to this namespace. The Kubernetes-tests CI job sources this file, so
# it must be set here for the bootstrap render to succeed.
OOD_PORTAL_NAMESPACE="ondemand"
IDP_ISSUER_URL="https://idp.example.com/auth/realms/main/protocol/openid-connect/token"
CLIENT_ID="changeme"
CLIENT_SECRET="changeme"
IMAGE_PULL_SECRET=""
REGISTRY_DOCKER_CONFIG_JSON="/some/path/to/docker/config.json"
USE_POD_SECURITY_POLICY=false
